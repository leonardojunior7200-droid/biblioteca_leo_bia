:root {
    --bg: #f4f5f7;
    --text: #333;
    --header-bg: #1e4b7d;
    --header-text: #ffffff;
    --card-bg: #ffffff;
    --border: #e0e4ea;
    --input-bg: #ffffff;
    --input-border: #ccd0d9;
    --button-bg: #1e4b7d;
    --button-color: #ffffff;
    --button-hover: #153b61;
    --link-color: #1e4b7d;
    --table-bg: #ffffff;
    --footer-text: #666;
    --flash-success-bg: #d4f0dd;
    --flash-success-border: #8fd19b;
    --flash-error-bg: #ffe4e1;
    --flash-error-border: #e11d48;
    --action-bg: #0f6d3f;
    --action-hover: #0b562f;
    --font-sans: "Inter", "Segoe UI", Roboto, Arial, sans-serif;
    --font-heading: "Poppins", "Inter", "Segoe UI", sans-serif;
}

body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    background: linear-gradient(rgba(7, 18, 34, 0.72), rgba(7, 18, 34, 0.72)), url('../img/library-bg.jpg') center/cover fixed;
    color: var(--text);
    min-height: 100vh;
    transition: background 0.2s ease;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

body.no-image,
body.background-light {
    background: var(--bg);
}

body.background-dark {
    background: linear-gradient(135deg, rgba(2, 6, 23, 0.95), rgba(15, 23, 42, 0.9));
    color: #f8fafc;
}

body.background-blue {
    background: linear-gradient(135deg, rgba(7, 40, 78, 0.95), rgba(30, 75, 125, 0.9));
}

body.custom-background {
    background-size: cover;
    background-position: center;
}

.settings-panel {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(10, 18, 34, 0.75);
    z-index: 1100;
}

.settings-panel.hidden {
    display: none;
}

.settings-panel-inner {
    width: min(560px, 100%);
    background: rgba(255, 255, 255, 0.98);
    border-radius: 20px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
    padding: 24px;
}

html.theme-dark .settings-panel-inner {
    background: rgba(18, 22, 34, 0.98);
}

.settings-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
}

.settings-panel-header h2 {
    margin: 0;
}

#settings-close {
    border: none;
    background: transparent;
    color: var(--text);
    font-size: 1.5rem;
    cursor: pointer;
}

.settings-panel-body .form-group {
    margin-bottom: 16px;
}

.settings-note {
    color: var(--text);
    opacity: 0.8;
    margin-top: 0;
}

html.theme-dark .settings-note {
    color: #e0e7ff;
}

.background-gallery {
    position: fixed;
    inset: 0;
    background: rgba(10, 18, 34, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    z-index: 1000;
}

.background-gallery.hidden {
    display: none;
}

.background-gallery-inner {
    width: min(960px, 100%);
    max-height: 80vh;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.96);
    border-radius: 20px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.32);
    padding: 20px;
}

html.theme-dark .background-gallery-inner {
    background: rgba(18, 22, 34, 0.98);
}

.background-gallery-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
}

.background-gallery-header h2 {
    margin: 0;
}

#background-gallery-close {
    background: transparent;
    color: var(--text);
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
}

.background-gallery-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
    margin-bottom: 16px;
}

.background-gallery-card {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    height: 160px;
    display: flex;
    flex-direction: column;
}

.background-gallery-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.background-gallery-card span {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 12px;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
    font-weight: 700;
}

.background-gallery-empty {
    color: var(--text);
    opacity: 0.75;
}

html.theme-dark .background-gallery-empty {
    color: #e0e7ff;
}

html.theme-dark,
body.theme-dark {
    --bg: #121214;
    --text: #e7e9ee;
    --header-bg: #0f172a;
    --header-text: #f8fafc;
    --card-bg: #1d2230;
    --border: #2b3448;
    --input-bg: #152033;
    --input-border: #33415c;
    --button-bg: #1e4b7d;
    --button-color: #ffffff;
    --button-hover: #153b61;
    --link-color: #1e4b7d;
    --table-bg: #152033;
    --footer-text: #a5b4fc;
    --flash-success-bg: #163d1e;
    --flash-success-border: #166534;
    --flash-error-bg: #581c1c;
    --flash-error-border: #991b1b;
    --action-bg: #0d9488;
    --action-hover: #0f766e;
}

header {
    background: rgba(30, 75, 125, 0.92);
    color: var(--header-text);
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    backdrop-filter: blur(4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
}

header .brand a {
    color: var(--header-text);
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.02em;
}

header nav {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
}

header nav a {
    color: var(--header-text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
}

header .nav-user {
    font-size: 0.95rem;
    opacity: 0.9;
    font-weight: 500;
}

main {
    max-width: 1080px;
    margin: 28px auto 36px;
    padding: 0 20px;
}

h1, h2, h3, h4 {
    font-family: var(--font-heading);
    line-height: 1.2;
    margin-top: 0;
    color: #0f2745;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.35);
}

html.theme-dark h1,
html.theme-dark h2,
html.theme-dark h3,
html.theme-dark h4,
body.theme-dark h1,
body.theme-dark h2,
body.theme-dark h3,
body.theme-dark h4 {
    color: #f8fafc;
}

footer {
    padding: 16px 20px;
    text-align: center;
    color: var(--footer-text);
}

.muted {
    color: var(--footer-text);
    font-style: italic;
}

.chart-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 12px;
}

.chart-panel {
    background: rgba(30, 75, 125, 0.04);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
}

.chart-panel h3 {
    margin-bottom: 12px;
    font-size: 1.05rem;
}

.chart-row {
    margin-bottom: 12px;
}

.chart-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
    font-size: 0.95rem;
}

.chart-bar {
    width: 100%;
    height: 10px;
    background: rgba(30, 75, 125, 0.12);
    border-radius: 999px;
    overflow: hidden;
}

.chart-bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #1e4b7d, #2563eb);
    border-radius: inherit;
}

.chart-bar span.low {
    background: linear-gradient(90deg, #0f766e, #34d399);
}

html.theme-dark .chart-panel,
body.theme-dark .chart-panel {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--border);
}

.card {
    background: rgba(255, 255, 255, 0.94);
    border-radius: 14px;
    padding: 22px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    margin-bottom: 20px;
    backdrop-filter: blur(2px);
}

html.theme-dark .card,
body.theme-dark .card {
    background: rgba(29, 34, 48, 0.95);
}

html.theme-dark .card h1,
html.theme-dark .card h2,
html.theme-dark .card p,
html.theme-dark .card label,
body.theme-dark .card h1,
body.theme-dark .card h2,
body.theme-dark .card p,
body.theme-dark .card label {
    color: #f8fafc;
}

html.theme-dark .form-group input,
html.theme-dark .form-group select,
html.theme-dark .form-group textarea,
body.theme-dark .form-group input,
body.theme-dark .form-group select,
body.theme-dark .form-group textarea {
    color: #f8fafc;
    background: rgba(15, 23, 42, 0.95);
    border-color: #475569;
}

html.theme-dark .form-group input::placeholder,
html.theme-dark .form-group textarea::placeholder,
body.theme-dark .form-group input::placeholder,
body.theme-dark .form-group textarea::placeholder {
    color: #cbd5e1;
}

html.theme-dark .btn-login,
html.theme-dark input[type="submit"],
body.theme-dark .btn-login,
body.theme-dark input[type="submit"] {
    color: #ffffff;
}

html.theme-dark .card h1,
html.theme-dark .card h2,
html.theme-dark .card p,
body.theme-dark .card h1,
body.theme-dark .card h2,
body.theme-dark .card p {
    color: #f8fafc;
}

.form-group {
    margin-bottom: 16px;
}

.form-group label {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
    color: var(--header-bg);
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--input-border);
    border-radius: 10px;
    font-size: 1rem;
    background: var(--input-bg);
    color: var(--text);
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.form-group select option {
    color: var(--text);
    background: var(--input-bg);
}

html.theme-dark .form-group select option,
body.theme-dark .form-group select option {
    color: #f8fafc;
    background: #152033;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--button-bg);
    box-shadow: 0 0 0 3px rgba(30, 75, 125, 0.16);
}

button,
input[type="submit"] {
    background: var(--button-bg);
    color: var(--button-color);
    border: none;
    padding: 12px 18px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 1rem;
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    box-shadow: 0 6px 16px rgba(30, 75, 125, 0.16);
}

.btn-primary,
button[type="submit"] {
    background: var(--button-bg);
    color: var(--button-color);
}

.btn-danger {
    background: linear-gradient(135deg, #dc2626, #ef4444);
    color: white;
    padding: 10px 16px;
    border-radius: 10px;
    font-weight: 600;
    box-shadow: 0 4px 10px rgba(220, 38, 38, 0.3);
    border: none;
    cursor: pointer;
    font-size: 1rem;
    font-family: var(--font-sans);
    letter-spacing: 0.01em;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
}

.btn-danger:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
}

.btn-secondary,
button.secondary {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text);
    border: 1px solid rgba(255, 255, 255, 0.12);
}

button:hover,
input[type="submit"]:hover,
.btn-secondary:hover,
button.secondary:hover {
    background: var(--button-hover);
}

button#theme-toggle {
    min-width: 120px;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 24px;
}

.page-header h1 {
    margin: 0;
    font-size: 2rem;
    color: var(--text);
}

.page-subtitle {
    margin: 0 0 8px;
    color: #94a3b8;
    font-size: 0.95rem;
}

.dashboard-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 24px;
}

.summary-card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 22px;
    min-height: 128px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.summary-card span {
    color: #94a3b8;
    font-size: 0.95rem;
    margin-bottom: 8px;
}

.summary-card strong {
    font-size: 2rem;
    display: block;
    margin-bottom: 8px;
}

.summary-card p {
    margin: 0;
    color: var(--link-color);
    font-size: 0.95rem;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: 2.2fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
}

.loan-panel,
.quick-actions,
.loan-history-card {
    background: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
}

.panel-label {
    margin: 0 0 6px;
    font-size: 0.85rem;
    color: var(--link-color);
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.panel-description {
    margin: 8px 0 0;
    color: #94a3b8;
    font-size: 0.95rem;
}

.filter-grid,
.loan-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 16px;
}

.loan-grid .form-group {
    margin-bottom: 0;
}

.filter-form,
.loan-form {
    margin-bottom: 20px;
}

.quick-actions .action-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.action-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
    border-radius: 18px;
    text-decoration: none;
    color: inherit;
    min-height: 110px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.action-card span {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    font-size: 1.2rem;
}

.action-card strong {
    display: block;
    margin-bottom: 4px;
    font-size: 1rem;
}

.action-card p {
    margin: 0;
    color: #94a3b8;
}

.action-primary { background: linear-gradient(135deg, rgba(59, 130, 246, 0.16), rgba(59, 130, 246, 0.08)); }
.action-warning { background: linear-gradient(135deg, rgba(234, 179, 8, 0.16), rgba(234, 179, 8, 0.08)); }
.action-info { background: linear-gradient(135deg, rgba(14, 165, 233, 0.16), rgba(14, 165, 233, 0.08)); }
.action-secondary { background: linear-gradient(135deg, rgba(168, 85, 247, 0.16), rgba(168, 85, 247, 0.08)); }

.table-wrapper {
    overflow-x: auto;
}

.loan-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 720px;
}

.loan-table th,
.loan-table td {
    padding: 16px 14px;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.loan-table thead {
    background: rgba(255, 255, 255, 0.04);
}

.loan-table th {
    color: #94a3b8;
    font-size: 0.9rem;
}

.loan-table td {
    color: #e2e8f0;
    vertical-align: middle;
}

.status-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
}

.status-active { background: #1f7d41; color: #d1fae5; }
.status-warning { background: #f59e0b; color: #fff7ed; }
.status-overdue { background: #dc2626; color: #fee2e2; }
.status-returned { background: #475569; color: #e2e8f0; }

.action-link {
    color: var(--link-color);
    text-decoration: none;
    font-weight: 600;
}

.action-muted {
    color: #94a3b8;
}

.empty-state {
    color: #94a3b8;
    padding: 20px 0;
}

.view-all-link {
    color: var(--link-color);
    text-decoration: none;
    font-weight: 600;
}

@media (max-width: 1000px) {
    .dashboard-summary,
    .dashboard-grid,
    .filter-grid,
    .loan-grid,
    .action-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 640px) {
    .page-header {
        flex-direction: column;
        align-items: stretch;
    }

    .panel-header {
        flex-direction: column;
        align-items: stretch;
    }

    .action-card {
        flex-direction: column;
        align-items: flex-start;
    }
}
.profile-card .profile-summary {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.profile-avatar {
    width: 92px;
    height: 92px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(30, 75, 125, 0.18);
    background: #fff;
}

.avatar-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
}

.avatar-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 12px;
    cursor: pointer;
    background: rgba(30, 75, 125, 0.04);
    text-align: center;
}

.avatar-option input {
    margin: 0;
}

.avatar-option img {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
}

.profile-form .actions {
    margin-top: 12px;
}

body.dashboard-page {
    background: #09111f;
    color: #f4f7ff;
}

body.dashboard-page header {
    display: none;
}

body.dashboard-page main {
    max-width: none;
    margin: 0;
    padding: 0;
}

.dashboard-shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    background: linear-gradient(135deg, #07101d 0%, #09111f 100%);
}

.dashboard-sidebar {
    background: rgba(7, 16, 31, 0.96);
    padding: 28px 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 12px 0 40px rgba(2, 8, 23, 0.35);
}

.sidebar-brand {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 6px 2px 24px;
}

.brand-mark {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #1e4b7d, #2563eb);
    color: white;
    box-shadow: 0 16px 30px rgba(37, 99, 235, 0.28);
}

.brand-mark svg {
    width: 24px;
    height: 24px;
}

.sidebar-brand h2 {
    margin: 0;
    font-size: 1rem;
    color: #f8fafc;
}

.sidebar-brand p {
    margin: 2px 0 0;
    color: #8da2c3;
    font-size: 0.85rem;
}

.sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #cbd5e1;
    text-decoration: none;
    padding: 12px 14px;
    border-radius: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.nav-item:hover,
.nav-item.active {
    background: linear-gradient(90deg, rgba(37, 99, 235, 0.22), rgba(37, 99, 235, 0.12));
    color: #ffffff;
    box-shadow: inset 0 0 0 1px rgba(96, 165, 250, 0.2);
}

.nav-icon {
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    font-size: 0.9rem;
}

.sidebar-logout {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 14px;
    color: #fda4af;
    text-decoration: none;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.03);
}

.dashboard-main-panel {
    padding: 30px 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.page-content-stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.page-content-stack .panel {
    margin-bottom: 0;
}

.dashboard-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 26px;
    border-radius: 24px;
    background: rgba(17, 31, 58, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 20px 45px rgba(2, 8, 23, 0.28);
}

.eyebrow,
.panel-eyebrow {
    margin: 0 0 6px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--link-color);
}

.dashboard-topbar h1 {
    margin: 0;
    color: #f8fafc;
    font-size: 1.8rem;
}

.topbar-subtitle,
.panel-subtitle {
    margin: 6px 0 0;
    color: #9fb0cf;
}

.topbar-actions {
    display: flex;
    align-items: center;
    gap: 14px;
}

.topbar-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.06);
    color: #f8fafc;
    box-shadow: none;
    padding: 0;
}

.topbar-user {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
}

.topbar-user img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
}

.topbar-user strong {
    display: block;
    color: #f8fafc;
    font-size: 0.95rem;
}

.topbar-user span {
    color: #9fb0cf;
    font-size: 0.8rem;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.stat-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: center;
    padding: 22px;
    border-radius: 20px;
    color: #f8fafc;
    box-shadow: 0 18px 36px rgba(2, 8, 23, 0.22);
}

.stat-card h3 {
    margin: 2px 0 4px;
    font-size: 1.65rem;
    color: #ffffff;
}

.stat-label {
    margin: 0;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.78);
}

.stat-meta {
    margin: 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: 0.95rem;
}

.stat-card a {
    grid-column: 2;
    color: #f8fafc;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    opacity: 0.95;
}

.stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    font-size: 1.2rem;
    background: rgba(255, 255, 255, 0.16);
}

.stat-books {
    background: linear-gradient(135deg, #1e4b7d, #2563eb 55%, #2563eb);
}

.stat-loans {
    background: linear-gradient(135deg, #7c3aed, #8b5cf6 55%, #c084fc);
}

.stat-reservations {
    background: linear-gradient(135deg, #0f766e, #14b8a6 55%, #2dd4bf);
}

.stat-users {
    background: linear-gradient(135deg, #ea580c, #f97316 55%, #fb923c);
}

.content-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 20px;
}

.panel {
    background: rgba(17, 31, 58, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 18px 38px rgba(2, 8, 23, 0.24);
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 18px;
}

.panel-header h2 {
    margin: 0 0 4px;
    color: #f8fafc;
    font-size: 1.2rem;
}

.soft-link {
    color: var(--link-color);
    text-decoration: none;
    font-weight: 600;
}

.loan-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.field-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: #e2e8f0;
}

.field-group span {
    font-size: 0.92rem;
    font-weight: 600;
}

.field-group select {
    width: 100%;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    color: #f8fafc;
}

.primary-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 12px 16px;
    border-radius: 14px;
    background: linear-gradient(135deg, #1e4b7d, #2563eb);
    color: white;
    text-decoration: none;
    font-weight: 700;
    box-shadow: 0 16px 26px rgba(37, 99, 235, 0.24);
}

.panel .muted,
.panel .empty-state {
    color: #9fb0cf;
}

.shortcut-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.shortcut-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    border-radius: 16px;
    text-decoration: none;
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: transform 0.2s ease, border-color 0.2s ease;
}

.shortcut-card:hover {
    transform: translateY(-3px);
    border-color: rgba(96, 165, 250, 0.38);
}

.shortcut-icon {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.28), rgba(96, 165, 250, 0.2));
    color: #bfdbfe;
}

.shortcut-card strong {
    font-size: 0.98rem;
}

.shortcut-card p {
    margin: 0;
    color: #9fb0cf;
    font-size: 0.88rem;
}

.table-panel {
    padding-bottom: 20px;
}

.table-wrapper {
    overflow-x: auto;
}

.dashboard-table {
    width: 100%;
    min-width: 740px;
    border-collapse: collapse;
}

.dashboard-table th,
.dashboard-table td {
    padding: 14px 10px;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.dashboard-table th {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #8da2c3;
}

.dashboard-table td {
    color: #f8fafc;
}

.user-cell,
.book-cell {
    display: flex;
    align-items: center;
    gap: 10px;
}

.user-cell img {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
}

.user-cell strong,
.book-cell strong {
    display: block;
    font-size: 0.95rem;
}

.user-cell span,
.book-cell span {
    color: #9fb0cf;
    font-size: 0.82rem;
}

.book-cover {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #1e4b7d, #2563eb);
    color: #f8fafc;
    font-weight: 700;
}

.status-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
}

.status-active {
    background: rgba(34, 197, 94, 0.18);
    color: #bbf7d0;
}

.status-returned {
    background: rgba(16, 155, 42, 0.18);
    color: #e2e8f0;
}

.status-overdue {
    background: rgba(248, 113, 113, 0.18);
    color: #fecaca;
}

.table-actions {
    display: flex;
    gap: 8px;
    justify-content: center;
    align-items: center;
}

.table-actions .btn-danger {
    min-width: 60px;
    font-size: 0.85rem;
}

.table-actions .btn-secondary {
    min-width: 80px;
    font-size: 0.85rem;
}

.icon-btn {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    border: 0;
    background: rgba(255, 255, 255, 0.06);
    color: #f8fafc;
    box-shadow: none;
    padding: 0;
}

.empty-state {
    color: #9fb0cf;
    padding: 22px 10px;
}

@media (max-width: 1100px) {
    .content-grid,
    .stats-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 860px) {
    .dashboard-shell {
        grid-template-columns: 1fr;
    }

    .dashboard-sidebar {
        border-right: 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        gap: 20px;
    }

    .stats-grid,
    .content-grid,
    .shortcut-grid {
        grid-template-columns: 1fr;
    }

    .dashboard-topbar {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media (max-width: 640px) {
    .dashboard-main-panel {
        padding: 20px 16px 28px;
    }

    .dashboard-topbar,
    .panel {
        padding: 18px;
    }
}

.nav-user {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-weight: 600;
}

.nav-user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(30, 75, 125, 0.18);
    background: #fff;
}

a {
    color: var(--link-color);
    font-weight: 600;
}

.report-filters {
    display: grid;
    gap: 12px;
}

.report-filters .actions {
    align-items: center;
}

.report-filters .btn-panel {
    margin-top: 0;
    text-decoration: none;
}

a:hover {
    text-decoration-thickness: 2px;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 12px;
    background: rgba(255, 255, 255, 0.9);
}

html.theme-dark table,
body.theme-dark table {
    background: rgba(21, 32, 51, 0.95);
}

html.theme-dark table th,
html.theme-dark table td,
body.theme-dark table th,
body.theme-dark table td {
    color: #f8fafc;
}

html.theme-dark table th,
body.theme-dark table th {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
}

html.theme-dark table tr:hover,
body.theme-dark table tr:hover {
    background: rgba(255, 255, 255, 0.06);
}

table th,
table td {
    padding: 13px 12px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    color: var(--text);
    vertical-align: middle;
}

table th {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #0f2745;
    background: rgba(30, 75, 125, 0.06);
}

table tr:hover {
    background: rgba(30, 75, 125, 0.04);
}

.flash {
    padding: 14px 18px;
    border-radius: 10px;
    margin-bottom: 18px;
    font-weight: 600;
}

.flash.success {
    background: var(--flash-success-bg);
    border: 1px solid var(--flash-success-border);
}

.flash.error {
    background: var(--flash-error-bg);
    border: 1px solid var(--flash-error-border);
    color: #7f1d1d;
    font-weight: 700;
}

.flash.warning {
    background: rgba(245, 158, 11, 0.16);
    border: 1px solid rgba(245, 158, 11, 0.45);
    color: #7c2d12;
}

html.theme-dark .flash.warning,
body.theme-dark .flash.warning {
    color: #fde68a;
}

.flash.error::before {
    content: 'Erro: ';
}

.alert-list {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 8px;
}

.alert-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
}

.alert-panel {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px;
    background: rgba(255, 255, 255, 0.75);
}

html.theme-dark .alert-panel,
body.theme-dark .alert-panel {
    background: rgba(255, 255, 255, 0.04);
}

.actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.actions a {
    display: inline-block;
    background: var(--action-bg);
    color: white;
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
}

.actions a:hover {
    background: var(--action-hover);
}

.btn-login,
.btn-panel {
    background: var(--button-bg);
    color: var(--button-color);
    border: none;
    border-radius: 10px;
    padding: 14px 18px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    transition: background 0.2s ease, transform 0.15s ease;
    cursor: pointer;
}

.btn-login {
    width: 100%;
    max-width: 320px;
}

.btn-panel {
    margin-top: 12px;
}

.btn-login:hover,
.btn-panel:hover {
    background: var(--button-hover);
    transform: translateY(-1px);
}

.btn-login:focus,
.btn-panel:focus {
    outline: 3px solid rgba(30, 75, 125, 0.25);
    outline-offset: 3px;
}

/* Dashboard-specific dark overrides: replace remaining white backgrounds with system card color */
body.dashboard-page {
    --card-bg-rgb: 17,31,58;
    --card-bg: #111F3A;
}

/* General surface replacements */
body.dashboard-page .settings-panel-inner,
body.dashboard-page .background-gallery-inner,
body.dashboard-page .card,
body.dashboard-page .chart-panel,
body.dashboard-page .table-panel,
body.dashboard-page .dashboard-topbar,
body.dashboard-page .dashboard-main-panel {
    background: rgba(var(--card-bg-rgb), 0.96) !important;
    border-color: rgba(174, 61, 61, 0.04) !important;
    color: #010a13 !important;
}



/* Alert panel in dashboard */
body.dashboard-page .alert-panel {
    background: rgba(var(--card-bg-rgb), 0.75) !important;
    border-color: rgba(255,255,255,0.04) !important;
}

/* Ensure table rows and headers keep dark surfaces */
body.dashboard-page .dashboard-table th,
body.dashboard-page .dashboard-table td {
    background: transparent !important;
}

/* Icon and small elements should use subtle light text */
body.dashboard-page .nav-item,
body.dashboard-page .nav-icon,
body.dashboard-page .stat-label,
body.dashboard-page .stat-meta {
    color: rgba(255,255,255,0.9) !important;
}
/* Força as opções de listas e menus a terem texto visível */
select, option, .dropdown-menu, .select2-results {
    color: #111F3A !important;
    background-color: #ffffff !important;
}

/* Se for uma lista comum de links ou itens */
body.dashboard-page select option,
body.dashboard-page .dropdown-item {
    color: #1e293b !important;
}
